<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Keystore ciphertext is useless without the device-bound key and should never leave the device. -->
    <exclude domain="sharedpref" path="punla_secure_secrets.xml" />
    <exclude domain="file" path="punla_diagnostics.log" />
    <!-- Phase 0 reliability probes/receipts are installation-local evidence and must not auto-restore. -->
    <exclude domain="sharedpref" path="punla_diagnostics_meta.xml" />
    <exclude domain="sharedpref" path="punla_reliability.xml" />
    <exclude domain="sharedpref" path="punla_restore_verification.xml" />
</full-backup-content>
