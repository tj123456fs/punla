<?xml version="1.0" encoding="utf-8"?>
<!--
  Glance widgets still need a plain framework "initialLayout" — Android
  inflates this immediately when the widget is placed, before Glance's
  own composable content is bound. Without it the widget host has nothing
  to draw and the widget fails to appear/load on the home screen.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B2E23">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:padding="12dp"
        android:text="Loading…"
        android:textColor="#B9C9BB"
        android:textSize="12sp" />

</FrameLayout>
